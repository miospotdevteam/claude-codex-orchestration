#!/usr/bin/env bash
set -euo pipefail

# One closed, local session boundary for Claude, Codex, and Grok on the Mini.
# Event records contain labels only; terminal and prompt content is never stored.
umask 077

SUPERVISOR_DIR=$(cd "$(dirname "$0")" && pwd -P)
REGISTRY_BIN="${AGENT_SUPERVISOR_REGISTRY:-$SUPERVISOR_DIR/workflow-registry}"

usage() {
  printf '%s\n' 'usage: agent-supervisor version|start|status|capture|send|interrupt|kill|enqueue|wait|reveal ...' >&2
  exit 64
}

die() {
  printf 'agent-supervisor: %s\n' "$*" >&2
  exit 1
}

# Host boot-time token for enqueue lock liveness (same source as workflow-registry).
boot_token() {
  local raw token sysctl_bin
  if [[ -r /proc/stat ]]; then
    awk '/^btime / { print $2; exit }' /proc/stat
    return
  fi
  if command -v sysctl >/dev/null 2>&1 || [[ -x /usr/sbin/sysctl ]]; then
    sysctl_bin=$(command -v sysctl 2>/dev/null || printf '%s\n' /usr/sbin/sysctl)
    raw=$($sysctl_bin -n kern.boottime 2>/dev/null || true)
    token=$(printf '%s\n' "$raw" | awk -F'[=,{} \t]+' '{
      for (i = 1; i <= NF; i++)
        if ($i == "sec" && $(i+1) ~ /^[0-9]+$/) { print $(i+1); exit }
    }')
    if [[ -n $token ]]; then
      printf '%s\n' "$token"
      return
    fi
  fi
  stat -c %W / 2>/dev/null || stat -f %B / 2>/dev/null || printf '0\n'
}

valid_workflow_id() {
  [[ ${1:-} =~ ^wf-[a-z0-9][a-z0-9-]{0,47}-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$ ]]
}

workflows_root() {
  printf '%s/orchestration/workflows\n' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

release_enqueue_lock() {
  local lock=${1:-}
  [[ -n $lock && -d $lock ]] || return 0
  rm -rf -- "$lock" 2>/dev/null || true
}

# Projection registry calls must finish strictly inside the 2 s hook budget.
# Default 1.5 s is genuinely shorter than 2 s (sub-second precision — never
# ceiling fractional budgets up to the full hook window).
# Read env on every call so callers can override per-invocation.
project_timeout_budget_ms() {
  local budget=${AGENT_SUPERVISOR_PROJECT_TIMEOUT:-}
  # Empty (env -i passthrough) or non-numeric → default 1.5 s (< 2 s hook budget).
  [[ $budget =~ ^[0-9]+([.][0-9]+)?$ ]] || budget=1.5
  # Convert to integer milliseconds; floor at 50 ms so a 0 override still spins once.
  awk -v b="$budget" 'BEGIN {
    ms = int(b * 1000 + 0.5)
    if (ms < 50) ms = 50
    print ms
  }'
}

# Wall-clock milliseconds (portable). Prefer high-res clocks so fractional
# projection budgets are real, not whole-second ceilings.
now_ms() {
  if command -v perl >/dev/null 2>&1; then
    perl -MTime::HiRes=time -e 'printf "%d\n", int(time * 1000)' 2>/dev/null && return 0
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import time; print(int(time.time() * 1000))' 2>/dev/null && return 0
  fi
  # Coarse fallback: whole seconds only.
  printf '%s\n' $(( $(date +%s) * 1000 ))
}

# Tear down a bounded child and its descendants (bash shim + /bin/sleep, etc.).
kill_bounded_tree() {
  local pid=$1
  # Parent + direct children so a hanging sleep under a shim cannot outlive us.
  kill -TERM "$pid" 2>/dev/null || true
  pkill -TERM -P "$pid" 2>/dev/null || true
  /bin/sleep 0.05
  kill -KILL "$pid" 2>/dev/null || true
  pkill -KILL -P "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
}

# Run a command under a shared wall-clock budget starting at start_ms.
# total_ms is the full allowance for the hook-path work (project + optional
# deliver share ONE budget — never stacked). Returns 124 on timeout.
# Uses a single fractional sleep watchdog (no perl poll loop) so sub-second
# budgets stay accurate under the 2 s hook window.
run_bounded_remaining() {
  local start_ms=$1 total_ms=$2
  shift 2
  local pid watcher rc=0 now remaining remaining_sec
  now=$(now_ms)
  remaining=$((total_ms - (now - start_ms)))
  if (( remaining <= 0 )); then
    return 124
  fi
  remaining_sec=$(awk -v ms="$remaining" 'BEGIN { printf "%.3f", ms / 1000 }')
  "$@" &
  pid=$!
  (
    /bin/sleep "$remaining_sec"
    # Still running past the shared deadline — tear down the tree.
    if kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid" 2>/dev/null || true
      pkill -TERM -P "$pid" 2>/dev/null || true
      /bin/sleep 0.05
      kill -KILL "$pid" 2>/dev/null || true
      pkill -KILL -P "$pid" 2>/dev/null || true
    fi
  ) &
  watcher=$!
  wait "$pid" 2>/dev/null || rc=$?
  # Cancel the watchdog if the child finished first.
  kill "$watcher" 2>/dev/null || true
  wait "$watcher" 2>/dev/null || true
  now=$(now_ms)
  # Signal death at/after the shared deadline is a timeout (GNU-like 124).
  if (( rc != 0 && now - start_ms >= total_ms )); then
    return 124
  fi
  return "$rc"
}

# Single-call convenience: fresh budget for one registry invocation.
run_bounded() {
  local start_ms total_ms
  start_ms=$(now_ms)
  total_ms=$(project_timeout_budget_ms)
  run_bounded_remaining "$start_ms" "$total_ms" "$@"
}

# Age of a path in whole seconds (0 if unreadable). Used for lock-init grace.
path_age_secs() {
  local path=$1 now mtime
  now=$(date +%s)
  mtime=$(stat -f %m "$path" 2>/dev/null || stat -c %Y "$path" 2>/dev/null || printf '%s\n' "$now")
  printf '%s\n' $(( now - mtime ))
}

# Append-only journal-pending key: one file per session+cursor+kind projection.
pending_projection_key() {
  local session=$1 cursor=$2 kind=$3
  # Sanitize path separators; keep the key filesystem-safe and labels-only.
  session=${session//\//_}
  printf '%s.%s.%s\n' "$session" "$cursor" "$kind"
}

ensure_journal_pending_dir() {
  local wf_dir=$1 pending="$1/journal-pending" legacy
  if [[ -f $pending ]]; then
    legacy="$pending.legacy.$$"
    mv -- "$pending" "$legacy" 2>/dev/null || true
    mkdir -p -m 700 -- "$pending" 2>/dev/null || return 1
    if [[ -f $legacy ]]; then
      mv -- "$legacy" "$pending/legacy-singleton" 2>/dev/null || rm -f -- "$legacy"
    fi
    return 0
  fi
  mkdir -p -m 700 -- "$pending" 2>/dev/null || return 1
}

write_journal_pending() {
  # Content MUST include session+cursor+kind so content-hash keys (if any
  # consumer still hashes the body) cannot collide across distinct projections.
  # The filename is already session.cursor.kind — the unique identity.
  local wf_dir=$1 key=$2 scope=$3 kind=$4 session=$5 cursor=$6 file
  ensure_journal_pending_dir "$wf_dir" || return 0
  file="$wf_dir/journal-pending/$key"
  printf '{"scope":"%s","kind":"%s","session":"%s","cursor":%s,"source":"enqueue"}\n' \
    "$scope" "$kind" "$session" "$cursor" >"$file" 2>/dev/null || true
  chmod 600 "$file" 2>/dev/null || true
}

clear_own_journal_pending() {
  local wf_dir=$1 key=$2
  rm -f -- "$wf_dir/journal-pending/$key" 2>/dev/null || true
}

valid_session() {
  case ${1:-} in
    remote-agent--miospot--claude|remote-agent--miospot--codex|remote-agent--miospot--grok|\
    remote-agent--orchestration--claude|remote-agent--orchestration--codex|remote-agent--orchestration--grok) return 0 ;;
  esac
  # Chat writer atoms: closed project, literal chat slot, strict chatid of
  # lowercase alphanumerics joined by single hyphens (1-63 bytes, anchored,
  # so separators, whitespace, globs, and traversal never form a session).
  [[ ${1:-} =~ ^remote-agent--(miospot|orchestration)--chat--[a-z0-9](-?[a-z0-9]){0,31}$ ]]
}

# Chat writer atoms share the session vocabulary but are not one of the six
# workflow slots; launch stays exactly the six-slot family.
chat_session() {
  case ${1:-} in remote-agent--*--chat--*) return 0 ;; *) return 1 ;; esac
}

session_harness() { printf '%s\n' "${1##*--}"; }

session_project() {
  local value=${1#remote-agent--}
  printf '%s\n' "${value%%--*}"
}

valid_pane() {
  case ${1:-} in
    %*[!0-9]*|%|'') return 1 ;;
    %*) return 0 ;;
    *) return 1 ;;
  esac
}

valid_uint() {
  case ${1:-} in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac
}

json_string() {
  # All callers pass closed atoms or canonical filesystem paths. This helper is
  # retained for the latter so status remains valid JSON on unusual roots.
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/$/\\n/' | tr -d '\n' | sed 's/\\n$//'
}

readonly state_base="${XDG_STATE_HOME:-$HOME/.local/state}/orchestration/agent-supervisor"

init_state() {
  case $state_base in /*) ;; *) die 'supervisor state root must be absolute' ;; esac
  [[ ! -L $state_base ]] || die 'supervisor state root must not be a symlink'
  mkdir -p "$state_base"
  [[ -d $state_base && ! -L $state_base && -O $state_base ]] \
    || die 'supervisor state root must be an owned real directory'
  [[ ! -L $state_base/sessions ]] || die 'supervisor sessions path must not be a symlink'
  mkdir -p "$state_base/sessions"
  [[ -d $state_base/sessions && ! -L $state_base/sessions && -O $state_base/sessions ]] \
    || die 'supervisor sessions path must be an owned real directory'
  chmod 700 "$state_base" "$state_base/sessions"
}

state_dir() { printf '%s/sessions/%s\n' "$state_base" "$1"; }

atomic_write() {
  local destination=$1 value=$2 temporary
  temporary="${destination}.tmp.$$.$RANDOM"
  printf '%s\n' "$value" >"$temporary"
  chmod 600 "$temporary"
  mv -f "$temporary" "$destination"
}

atomic_write_launcher() {
  local destination=$1 session=$2 temporary
  [[ ! -L $destination ]] || die 'reveal launcher must not be a symlink'
  if [[ -e $destination && ( ! -f $destination || ! -O $destination ) ]]; then
    die 'reveal launcher must be an owned regular file'
  fi
  temporary=$(mktemp "${destination}.tmp.XXXXXX") || die 'cannot create reveal launcher temporary'
  if ! {
    printf '%s\n' '#!/bin/sh' "exec tmux attach-session -t '$session'" >"$temporary" &&
      chmod 700 "$temporary" &&
      mv -f "$temporary" "$destination"
  }; then
    rm -f "$temporary"
    die 'cannot install reveal launcher'
  fi
  [[ -f $destination && ! -L $destination && -O $destination && -x $destination ]] \
    || die 'installed reveal launcher is not private'
}

open_terminal_launcher() {
  local launcher=$1
  if [[ -n ${AGENT_SUPERVISOR_TEST_OPEN:-} ]]; then
    case $AGENT_SUPERVISOR_TEST_OPEN in /*) ;; *) die 'test open command must be absolute' ;; esac
    [[ -x $AGENT_SUPERVISOR_TEST_OPEN ]] || die 'test open command is unavailable'
    "$AGENT_SUPERVISOR_TEST_OPEN" -a Terminal -- "$launcher" >/dev/null
    return
  fi
  /usr/bin/open -a Terminal -- "$launcher" >/dev/null
}

acquire_lock() {
  local lock=$1 attempts=0 holder pid held_boot current_boot stale live_spins=0 age
  # Dead/wrong-boot holders are broken. A live same-boot holder is busy after a
  # few brief spins so the 2 s hook budget is never spent waiting on a live lock.
  # Holder is written immediately after mkdir. Contenders that observe a missing
  # holder MUST grace-wait (keyed to lock dir age + acquiring window) so they
  # never steal a newly acquired LIVE lock mid-populate.
  # /bin/sleep avoids PATH sleep shims and keeps spin cost predictable.
  current_boot=$(boot_token)
  while (( attempts < 50 )); do
    if mkdir -m 700 -- "$lock" 2>/dev/null; then
      # Critical section start: holder record BEFORE the lock is "held" for
      # contenders. Any failure after mkdir still leaves a young lock dir that
      # peers grace over rather than steal.
      holder="$lock/holder"
      printf 'pid=%s\nboot=%s\n' "$$" "$current_boot" >"$holder"
      chmod 600 "$holder"
      return 0
    fi

    holder="$lock/holder"
    pid=$(sed -n 's/^pid=\([0-9][0-9]*\)$/\1/p' "$holder" 2>/dev/null | head -n 1 || true)
    held_boot=$(sed -n 's/^boot=\(.*\)$/\1/p' "$holder" 2>/dev/null | head -n 1 || true)

    # Missing/corrupt holder: grace window — never treat a temporarily missing
    # holder file as immediately stale (init race).
    if [[ -z $pid || -z $held_boot ]]; then
      if [[ -d $lock ]]; then
        age=$(path_age_secs "$lock")
        # Grace: up to ~1s of wall age, or a few spins if clock is coarse.
        if (( age <= 1 )); then
          live_spins=$((live_spins + 1))
          if (( live_spins >= 8 )); then
            die 'event state is busy'
          fi
          /bin/sleep 0.02
          attempts=$((attempts + 1))
          continue
        fi
      fi
      # Older than grace with no verifiable holder → break as stale.
      stale="${lock}.stale.$$.$attempts"
      if mv -- "$lock" "$stale" 2>/dev/null; then
        rm -rf -- "$stale"
      fi
      attempts=$((attempts + 1))
      continue
    fi

    # Live holder on this boot: brief spin, then refuse busy (do not steal).
    if [[ $held_boot == "$current_boot" ]] && kill -0 "$pid" 2>/dev/null; then
      live_spins=$((live_spins + 1))
      if (( live_spins >= 3 )); then
        die 'event state is busy'
      fi
      /bin/sleep 0.01
      attempts=$((attempts + 1))
      continue
    fi

    # Dead pid or wrong boot: break and retry.
    stale="${lock}.stale.$$.$attempts"
    if mv -- "$lock" "$stale" 2>/dev/null; then
      rm -rf -- "$stale"
    fi
    attempts=$((attempts + 1))
  done
  die 'event state is busy'
}

# Project session event labels into the bound workflow journal (fail-open).
# Session event is already committed; projection/delivery failures never fail enqueue.
# journal-pending is an append-only set keyed by session+cursor+kind.
# project-event and optional deliver-queue share ONE projection budget so the
# input-needed success path cannot stack two full timeouts inside the 2 s hook.
project_bound_workflow() {
  local directory=$1 session=$2 cursor=$3 scope=$4 kind=$5
  local workflow_id wf_dir pending_key had_pending=0 reg rc=0
  local start_ms total_ms
  [[ -f $directory/workflow ]] || return 0
  IFS= read -r workflow_id <"$directory/workflow" || true
  valid_workflow_id "$workflow_id" || return 0
  wf_dir="$(workflows_root)/$workflow_id"
  [[ -d $wf_dir ]] || return 0
  pending_key=$(pending_projection_key "$session" "$cursor" "$kind")

  # Write this projection's pending record FIRST so a kill mid-registry still
  # leaves an append-only reconcile marker within the hook budget.
  write_journal_pending "$wf_dir" "$pending_key" "$scope" "$kind" "$session" "$cursor"

  [[ -f $wf_dir/pending-send.json || -f $wf_dir/pending-send.payload ]] && had_pending=1

  reg=$REGISTRY_BIN
  [[ -x $reg ]] || reg=$SUPERVISOR_DIR/workflow-registry
  [[ -x $reg ]] || {
    if [[ $kind == input-needed && $had_pending -eq 1 ]]; then
      printf 'delivery-pending\n' >"$wf_dir/delivery-pending" 2>/dev/null || true
      chmod 600 "$wf_dir/delivery-pending" 2>/dev/null || true
    fi
    return 0
  }

  # Single combined wall-clock budget for the entire projection/delivery path.
  start_ms=$(now_ms)
  total_ms=$(project_timeout_budget_ms)

  rc=0
  run_bounded_remaining "$start_ms" "$total_ms" \
    "$reg" project-event "$workflow_id" "$scope" "$kind" >/dev/null 2>&1 || rc=$?
  if (( rc == 0 )); then
    # project-event raises the latch and runs queue-one delivery for input-needed.
    # If a pending message somehow remains, try deliver-queue fail-open under the
    # REMAINING shared budget (never a fresh second full timeout).
    if [[ $kind == input-needed && ( -f $wf_dir/pending-send.json || -f $wf_dir/pending-send.payload ) ]]; then
      if ! run_bounded_remaining "$start_ms" "$total_ms" \
        "$reg" deliver-queue "$workflow_id" >/dev/null 2>&1; then
        printf 'delivery-pending\n' >"$wf_dir/delivery-pending" 2>/dev/null || true
        chmod 600 "$wf_dir/delivery-pending" 2>/dev/null || true
      fi
    fi
    # Success clears only THIS projection's record; siblings stay.
    clear_own_journal_pending "$wf_dir" "$pending_key"
    return 0
  fi

  # Projection failed or timed out: leave own pending record; enqueue stays open.
  if [[ $kind == input-needed && $had_pending -eq 1 ]]; then
    printf 'delivery-pending\n' >"$wf_dir/delivery-pending" 2>/dev/null || true
    chmod 600 "$wf_dir/delivery-pending" 2>/dev/null || true
  fi
  return 0
}

bounded_tail() {
  tail -n 40 | tail -c 4096
}

require_existing() {
  valid_session "$1" || usage
  tmux has-session -t "$1" 2>/dev/null || die "session is absent: $1"
}

current_epoch() {
  local directory
  directory=$(state_dir "$1")
  [[ -f $directory/epoch ]] || die "missing supervisor state: $1"
  IFS= read -r REPLY <"$directory/epoch"
  printf '%s\n' "$REPLY"
}

current_cursor() {
  local directory value=0
  directory=$(state_dir "$1")
  if [[ -f $directory/cursor ]]; then IFS= read -r value <"$directory/cursor"; fi
  valid_uint "$value" || die 'corrupt event cursor'
  printf '%s\n' "$value"
}

emit_bootstrap() {
  local session=$1 epoch cursor
  epoch=$(current_epoch "$session")
  cursor=$(current_cursor "$session")
  emit_bootstrap_boundary "$session" "$epoch" "$cursor"
}

emit_bootstrap_boundary() {
  local session=$1 epoch=$2 cursor=$3
  printf '{"session":"running","name":"%s","epoch":"%s","cursor":%s,"bootstrapCursor":"%s:%s"}\n' \
    "$session" "$epoch" "$cursor" "$epoch" "$cursor"
}

command=${1:-}
case $command in
  version)
    [[ $# -eq 1 ]] || usage
    printf '%s\n' agent-supervisor-v1
    exit 0
    ;;
  start|status|capture|send|interrupt|kill|enqueue|wait|reveal) ;;
  *) usage ;;
esac
shift
init_state

case $command in
  start)
    # start SESSION HARNESS PROJECT_ROOT_TOKEN --yolo
    # start SESSION HARNESS PROJECT_ROOT_TOKEN --workflow-binding PATH --yolo
    workflow_binding=
    if [[ $# -eq 4 && $4 == --yolo ]]; then
      session=$1 harness=$2 requested_root_token=$3
    elif [[ $# -eq 6 && $4 == --workflow-binding && $6 == --yolo ]]; then
      session=$1 harness=$2 requested_root_token=$3
      workflow_binding=$5
    else
      usage
    fi
    valid_session "$session" || usage
    # Chat writer atoms never widen the six-slot launch surface, even when a
    # chatid collides with a harness name.
    ! chat_session "$session" || usage
    case $harness in claude|codex|grok) ;; *) usage ;; esac
    [[ $(session_harness "$session") == "$harness" ]] || usage
    case $requested_root_token in
      project-root-v1:miospot) requested_project=miospot; requested_root=$HOME/Projects/miospot ;;
      project-root-v1:orchestration) requested_project=orchestration; requested_root=$HOME/Projects/orchestration ;;
      *) die 'start requires a closed project root token' ;;
    esac
    [[ $(session_project "$session") == "$requested_project" ]] || die 'project root token does not match session project'
    [[ -d $requested_root && ! -L $requested_root ]] || die 'worktree root must be a real directory'
    root=$(cd "$requested_root" && pwd -P) || die 'cannot canonicalize worktree root'
    tmux has-session -t "$session" 2>/dev/null && die "session already exists: $session"
    if [[ -n $workflow_binding ]]; then
      [[ -f $workflow_binding && ! -L $workflow_binding ]] \
        || die 'workflow binding file must be an owned regular file'
      [[ -O $workflow_binding ]] || die 'workflow binding file must be owned'
      IFS= read -r bound_workflow <"$workflow_binding" || true
      valid_workflow_id "${bound_workflow:-}" || die 'workflow binding file must contain a valid workflowId'
    fi

    directory=$(state_dir "$session")
    mkdir -p "$directory/events"
    chmod 700 "$directory" "$directory/events"
    cursor=0
    if [[ -f $directory/cursor ]]; then IFS= read -r cursor <"$directory/cursor"; fi
    valid_uint "$cursor" || die 'corrupt event cursor'
    rm -f "$directory/events/"*
    rm -f "$directory/workflow"
    epoch="epoch-$(date +%s)-$$-$RANDOM"

    start_complete=0
    # The pre-launch cursor is the first-wait boundary. Preserve it if any
    # placeholder, binding, or harness launch operation fails.
    rollback_start() {
      local status=$?
      if [[ $start_complete -eq 0 ]]; then
        tmux has-session -t "$session" 2>/dev/null && tmux kill-session -t "$session" 2>/dev/null || true
        rm -rf "$directory"
        mkdir -p "$directory/events" 2>/dev/null || true
        chmod 700 "$directory" "$directory/events" 2>/dev/null || true
        atomic_write "$directory/cursor" "$cursor" 2>/dev/null || true
      fi
      exit "$status"
    }
    trap rollback_start EXIT

    # Create an attachable dormant pane first. The TUI is spawned only after
    # the exact pane binding and restart epoch are durable, so its hooks can
    # enqueue their first lifecycle event without racing supervisor state.
    tmux new-session -d -s "$session" -c "$root"
    pane=$(tmux display-message -p -t "$session:0.0" '#{pane_id}' 2>/dev/null || true)
    if ! valid_pane "$pane"; then
      pane=$(tmux list-panes -t "$session" -F '#{pane_id}' 2>/dev/null | head -n 1 || true)
    fi
    valid_pane "$pane" || die 'cannot bind exact tmux pane'
    atomic_write "$directory/root" "$root"
    atomic_write "$directory/harness" "$harness"
    atomic_write "$directory/pane" "$pane"
    atomic_write "$directory/epoch" "$epoch"
    atomic_write "$directory/cursor" "$cursor"
    if [[ -n $workflow_binding ]]; then
      atomic_write "$directory/workflow" "$bound_workflow"
    fi
    tmux respawn-pane -k -t "$pane" -c "$root" -- "$harness" --yolo
    start_complete=1
    trap - EXIT
    emit_bootstrap_boundary "$session" "$epoch" "$cursor"
    ;;

  status)
    [[ $# -eq 1 ]] || usage
    session=$1
    valid_session "$session" || usage
    directory=$(state_dir "$session")
    if tmux has-session -t "$session" 2>/dev/null; then
      emit_bootstrap "$session"
    else
      printf '{"session":"absent","name":"%s"}\n' "$session"
    fi
    ;;

  capture)
    [[ $# -eq 1 ]] || usage
    session=$1
    require_existing "$session"
    if [[ -n ${SUPERVISOR_CAPTURE_FILE:-} ]]; then
      bounded_tail <"$SUPERVISOR_CAPTURE_FILE"
    else
      tmux capture-pane -p -t "$session" -S -200 | bounded_tail
    fi
    ;;

  send)
    [[ $# -eq 1 ]] || usage
    session=$1
    require_existing "$session"
    directory=$(state_dir "$session")
    [[ -f $directory/harness ]] || die 'missing session harness state'
    IFS= read -r harness <"$directory/harness"
    [[ $harness == "$(session_harness "$session")" ]] || die 'session harness state mismatch'
    first=''
    if ! IFS= read -r -n 1 first; then die 'send requires non-empty stdin'; fi
    temporary=$(mktemp "$directory/.send.XXXXXX") || die 'cannot create private send buffer'
    cleanup_send() { rm -f "$temporary"; }
    trap cleanup_send EXIT HUP INT TERM
    { printf '%s' "$first"; cat; } >"$temporary"
    chmod 600 "$temporary"
    buffer="remote-agent-$$-$RANDOM"
    case $harness in
      codex|grok)
        bytes=$(wc -c <"$temporary" | tr -d ' ')
        last_byte=$(tail -c 1 "$temporary" | od -An -tuC | tr -d ' ')
        if [[ $last_byte == 10 ]]; then
          head -c "$((bytes - 1))" "$temporary" | tmux load-buffer -b "$buffer" -
        else
          tmux load-buffer -b "$buffer" - <"$temporary"
        fi
        ;;
      claude) tmux load-buffer -b "$buffer" - <"$temporary" ;;
    esac
    tmux paste-buffer -d -b "$buffer" -t "$session"
    # TUIs process bracketed paste asynchronously; submitting in the same
    # scheduler tick can leave the text sitting in the composer.
    sleep 0.1
    tmux send-keys -t "$session" Enter
    rm -f "$temporary"
    trap - EXIT HUP INT TERM
    ;;

  interrupt)
    [[ $# -eq 1 ]] || usage
    session=$1
    require_existing "$session"
    tmux send-keys -t "$session" C-c
    ;;

  kill)
    [[ $# -eq 1 ]] || usage
    session=$1
    valid_session "$session" || usage
    tmux has-session -t "$session" 2>/dev/null || die "session is absent: $session"
    tmux kill-session -t "$session"
    ;;

  enqueue)
    [[ $# -eq 4 ]] || usage
    requested_root=$1 pane=$2 scope=$3 kind=$4
    valid_pane "$pane" || usage
    case $scope in main|subagent) ;; *) usage ;; esac
    case $kind in completed|failed|input-needed) ;; *) usage ;; esac
    [[ -d $requested_root ]] || die 'event root is not a directory'
    root=$(cd "$requested_root" && pwd -P) || die 'cannot canonicalize event root'

    matched=''
    # One shared loop: the six workflow slots and the chat writer family both
    # live under the remote-agent-- prefix, and only names that pass the
    # closed session vocabulary may participate in root/pane matching.
    for directory in "$state_base/sessions/"remote-agent--*; do
      session=${directory##*/}
      valid_session "$session" || continue
      [[ -d $directory && -f $directory/root && -f $directory/pane ]] || continue
      IFS= read -r stored_root <"$directory/root"
      IFS= read -r stored_pane <"$directory/pane"
      if [[ $stored_root == "$root" && $stored_pane == "$pane" ]] && tmux has-session -t "$session" 2>/dev/null; then
        [[ -z $matched ]] || die 'ambiguous root and pane binding'
        matched=$session
      fi
    done
    [[ -n $matched ]] || die 'no exact supervisor root and pane binding'
    directory=$(state_dir "$matched")
    lock=$directory/enqueue.lock
    acquire_lock "$lock"
    trap 'release_enqueue_lock "'"$lock"'"' EXIT HUP INT TERM
    cursor=$(current_cursor "$matched")
    cursor=$((cursor + 1))
    event=$(printf '%020d' "$cursor")
    temporary="$directory/events/.${event}.$$.$RANDOM"
    printf '%s %s\n' "$scope" "$kind" >"$temporary"
    chmod 600 "$temporary"
    mv -f "$temporary" "$directory/events/$event"
    atomic_write "$directory/cursor" "$cursor"
    # Session event is durable first. Projection is fail-open within the hook budget.
    project_bound_workflow "$directory" "$matched" "$cursor" "$scope" "$kind" || true
    release_enqueue_lock "$lock"
    trap - EXIT HUP INT TERM
    ;;

  wait)
    [[ $# -eq 3 ]] || usage
    session=$1 supplied_cursor=$2 timeout=$3
    valid_session "$session" || usage
    valid_uint "$timeout" || usage
    (( timeout <= 300 )) || usage
    case $supplied_cursor in
      0) after=0 ;;
      epoch-*:*)
        supplied_epoch=${supplied_cursor%:*}
        after=${supplied_cursor##*:}
        case $supplied_epoch in epoch-|*[!A-Za-z0-9._-]*) usage ;; esac
        valid_uint "$after" || usage
        ;;
      *) usage ;;
    esac
    directory=$(state_dir "$session")
    [[ -d $directory && -f $directory/epoch ]] || die "missing supervisor state: $session"
    deadline=$((SECONDS + timeout))
    while :; do
      epoch=$(current_epoch "$session")
      cursor=$(current_cursor "$session")
      event_file=''
      for candidate in "$directory/events/"[0-9]*; do
        [[ -f $candidate ]] || continue
        candidate_cursor=$((10#${candidate##*/}))
        if (( candidate_cursor > after )); then event_file=$candidate; break; fi
      done
      if [[ -n $event_file ]]; then
        IFS=' ' read -r scope kind <"$event_file"
        event_cursor=$((10#${event_file##*/}))
        printf '{"epoch":"%s","cursor":%s,"session":"%s","wake":"event","scope":"%s","kind":"%s"}\n' \
          "$epoch" "$event_cursor" "$session" "$scope" "$kind"
        exit 0
      fi
      if ! tmux has-session -t "$session" 2>/dev/null; then
        printf '{"epoch":"%s","cursor":%s,"session":"%s","wake":"exit"}\n' "$epoch" "$cursor" "$session"
        exit 0
      fi
      if (( SECONDS >= deadline )); then
        printf '{"epoch":"%s","cursor":%s,"session":"%s","wake":"timeout"}\n' "$epoch" "$cursor" "$session"
        exit 0
      fi
      sleep 0.05
    done
    ;;

  reveal)
    [[ $# -eq 1 ]] || usage
    session=$1
    require_existing "$session"
    reveal_dir="$state_base/reveal"
    [[ ! -L $reveal_dir ]] || die 'reveal state path must not be a symlink'
    mkdir -p "$reveal_dir"
    [[ -d $reveal_dir && ! -L $reveal_dir && -O $reveal_dir ]] \
      || die 'reveal state path must be an owned real directory'
    chmod 700 "$reveal_dir"
    launcher="$reveal_dir/$session.command"
    # The validated session is a closed atom, single-quoted in a fixed command;
    # prompt stdin is ignored and never reaches the launcher or open argv.
    atomic_write_launcher "$launcher" "$session"
    open_terminal_launcher "$launcher"
    ;;
esac

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent TEMPLATE for MacBook mirror-worker (GUI session).

  Mechanical SSH-pull worker: long-polls mirror-next, stages/applies claimed
  jobs, never opens an inbound listener. Direction and ownership stay on the
  Mini registry; this agent only drains the durable queue on wake.

  Placeholders (substituted ONLY at install time):
    @PLUGIN_ROOT@  — absolute path to the orchestration plugin root
    @STATE_HOME@   — XDG_STATE_HOME or $HOME/.local/state
    @REMOTE_HOST@  — Mini host (Tailscale name or config equivalent)

  This tracked file is a template and is NOT installed until an install
  step writes a substituted copy under ~/Library/LaunchAgents/
  (optional load). Do not treat the presence of this template as
  evidence that the agent is loaded.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.orchestration.mirror-worker</string>
	<key>ProgramArguments</key>
	<array>
		<string>@PLUGIN_ROOT@/scripts/mirror-worker</string>
		<string>--host</string>
		<string>@REMOTE_HOST@</string>
		<string>run</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>@STATE_HOME@/orchestration/mirror-worker/logs/mirror-worker.launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>@STATE_HOME@/orchestration/mirror-worker/logs/mirror-worker.launchd.err.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>

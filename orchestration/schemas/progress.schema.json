{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestration.claude/schemas/progress.schema.json",
  "title": "Progress",
  "description": "Mutable v2 orchestration plan execution state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planId",
    "startedAt",
    "lastUpdatedAt",
    "currentFrontier",
    "steps"
  ],
  "properties": {
    "planId": {
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lastUpdatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "currentFrontier": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/stepProgress"
      }
    },
    "deviations": {
      "type": "array",
      "description": "Plan-level deviations: events that changed how the plan as a whole executes (a panel lane failing, an executor rerouted for quota, a model id migration). Step-scoped divergences belong in steps.<id>.deviations instead.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "note"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor",
        "model",
        "effort",
        "startedAt"
      ],
      "properties": {
        "executor": {
          "enum": [
            "codex",
            "grok",
            "claude"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "laneDispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "executor",
        "model",
        "effort",
        "dispatchedAt"
      ],
      "properties": {
        "lane": {
          "enum": [
            "claude",
            "codex",
            "grok"
          ]
        },
        "executor": {
          "enum": [
            "claude",
            "codex",
            "grok"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "minLength": 1
        },
        "dispatchedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "stepProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "in_progress",
            "done",
            "blocked",
            "skipped"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "owner": {
          "enum": [
            "codex-impl",
            "claude-impl",
            "grok-impl",
            "manual"
          ]
        },
        "dispatch": {
          "$ref": "#/$defs/dispatch"
        },
        "laneDispatches": {
          "description": "Latest durable verifier dispatch per lane. A lane dispatch without a corresponding current verdict is actively verifying.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "claude": {
              "$ref": "#/$defs/laneDispatch",
              "properties": {
                "lane": {
                  "const": "claude"
                },
                "executor": {
                  "const": "claude"
                }
              }
            },
            "codex": {
              "$ref": "#/$defs/laneDispatch",
              "properties": {
                "lane": {
                  "const": "codex"
                },
                "executor": {
                  "const": "codex"
                }
              }
            },
            "grok": {
              "$ref": "#/$defs/laneDispatch",
              "properties": {
                "lane": {
                  "const": "grok"
                },
                "executor": {
                  "const": "grok"
                }
              }
            }
          }
        },
        "verdict": {
          "description": "Authoritative single-verdict field (legacy flat record). Lane-scoped history lives under verdicts.",
          "enum": [
            "PASS",
            "FINDINGS",
            "FAIL"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "result": {
          "type": "string"
        },
        "verdicts": {
          "description": "Per-lane verifier records (claude / codex / grok). Routing-profile all-pass gating reads these; legacy plans use their owner-matrix gate.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "claude": {
              "$ref": "#/$defs/laneVerdict"
            },
            "codex": {
              "$ref": "#/$defs/laneVerdict"
            },
            "grok": {
              "$ref": "#/$defs/laneVerdict"
            },
            "claude": {
              "$ref": "#/$defs/laneVerdict"
            }
          }
        },
        "deviations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deviation"
          }
        },
        "filesTouched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "laneVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "summary",
        "findings",
        "filesTouched",
        "timestamp"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "PASS",
            "FINDINGS",
            "FAIL"
          ]
        },
        "summary": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filesTouched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description",
        "files"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    }
  }
}

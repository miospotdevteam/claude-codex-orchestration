{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestration.claude/schemas/progress.schema.json",
  "title": "Progress",
  "description": "Mutable v2 orchestration plan execution state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planId",
    "startedAt",
    "lastUpdatedAt",
    "currentFrontier",
    "steps"
  ],
  "properties": {
    "planId": {
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lastUpdatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "currentFrontier": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/stepProgress"
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor",
        "model"
      ],
      "properties": {
        "executor": {
          "enum": [
            "codex",
            "grok",
            "claude"
          ]
        },
        "model": {
          "type": "string"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "stepProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "in_progress",
            "done",
            "blocked",
            "skipped"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "owner": {
          "enum": [
            "codex-impl",
            "claude-impl",
            "grok-impl",
            "manual"
          ]
        },
        "dispatch": {
          "$ref": "#/$defs/dispatch"
        },
        "verdict": {
          "enum": [
            "PASS",
            "FINDINGS",
            "FAIL"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "result": {
          "type": "string"
        },
        "deviations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deviation"
          }
        },
        "filesTouched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description",
        "files"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    }
  }
}

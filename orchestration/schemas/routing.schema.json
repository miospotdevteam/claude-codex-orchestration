{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestration.claude/schemas/routing.schema.json",
  "title": "Orchestration routing profile",
  "description": "Selects one root orchestrator and the bounded model lanes used for each orchestration scenario.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "profile",
    "policy",
    "routing"
  ],
  "properties": {
    "format_version": {
      "const": 2
    },
    "profile": {
      "enum": [
        "codex-primary",
        "fable-primary"
      ]
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "routing": {
      "$ref": "#/$defs/routing"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "codex-primary"
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "policy": {
            "properties": {
              "claude_workers": {
                "const": "deny"
              }
            }
          },
          "routing": {
            "properties": {
              "orchestrator": {
                "const": {
                  "strategy": "single",
                  "lanes": [
                    {
                      "id": "primary",
                      "model": "gpt-5.6-sol",
                      "reasoning": "xhigh"
                    }
                  ]
                }
              },
              "planning_convergence": {
                "$ref": "#/$defs/noClaudeRoute"
              },
              "exploration": {
                "$ref": "#/$defs/noClaudeRoute"
              },
              "implementation": {
                "$ref": "#/$defs/noClaudeRoute"
              },
              "verification_review": {
                "$ref": "#/$defs/noClaudeRoute"
              },
              "design_taste": {
                "$ref": "#/$defs/noClaudeRoute"
              },
              "bulk_simple": {
                "$ref": "#/$defs/noClaudeRoute"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "const": "fable-primary"
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "policy": {
            "properties": {
              "claude_workers": {
                "const": "allow"
              }
            }
          },
          "routing": {
            "properties": {
              "orchestrator": {
                "const": {
                  "strategy": "single",
                  "lanes": [
                    {
                      "id": "primary",
                      "model": "claude-fable",
                      "reasoning": "xhigh"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claude_workers"
      ],
      "properties": {
        "claude_workers": {
          "enum": [
            "allow",
            "deny"
          ]
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "model",
        "reasoning"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "enum": [
            "gpt-5.6-sol",
            "gpt-5.6-terra",
            "gpt-5.6-luna",
            "grok-4.5",
            "claude-fable",
            "claude-opus",
            "claude-sonnet"
          ]
        },
        "reasoning": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "model": {
                "const": "grok-4.5"
              }
            },
            "required": [
              "model"
            ]
          },
          "then": {
            "properties": {
              "reasoning": {
                "const": "high"
              }
            }
          }
        }
      ]
    },
    "noClaudeRoute": {
      "type": "object",
      "properties": {
        "lanes": {
          "items": {
            "properties": {
              "model": {
                "enum": [
                  "gpt-5.6-sol",
                  "gpt-5.6-terra",
                  "gpt-5.6-luna",
                  "grok-4.5"
                ]
              }
            }
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "lanes"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "single",
            "parallel_converge",
            "frontier",
            "parallel_gate"
          ]
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lane"
          }
        },
        "convergence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner"
          ],
          "properties": {
            "owner": {
              "const": "orchestrator"
            }
          }
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "require",
            "cross_family_required"
          ],
          "properties": {
            "require": {
              "const": "all"
            },
            "cross_family_required": {
              "const": true
            }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orchestrator",
        "planning_convergence",
        "exploration",
        "implementation",
        "verification_review",
        "design_taste",
        "bulk_simple"
      ],
      "properties": {
        "orchestrator": {
          "$ref": "#/$defs/route"
        },
        "planning_convergence": {
          "$ref": "#/$defs/route"
        },
        "exploration": {
          "$ref": "#/$defs/route"
        },
        "implementation": {
          "$ref": "#/$defs/route"
        },
        "verification_review": {
          "$ref": "#/$defs/route"
        },
        "design_taste": {
          "$ref": "#/$defs/route"
        },
        "bulk_simple": {
          "$ref": "#/$defs/route"
        }
      }
    }
  }
}
